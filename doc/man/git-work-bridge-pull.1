.SH NAME
git-work-bridge-pull - Pull updates from a remote bug tracker


.SH SYNOPSIS
\fBgit-work bridge pull [NAME] [flags]\fP


.SH DESCRIPTION
Pull updates from a remote bug tracker


.SH OPTIONS
\fB-n\fP, \fB--no-resume\fP[=false]
	force importing all issues

.PP
\fB-s\fP, \fB--since\fP=""
	import only issues updated after the given date (ex: "200h" or "june 2 2019")

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for pull


.SH SEE ALSO
\fBgit-work-bridge(1)\fP
